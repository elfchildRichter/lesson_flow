# AI 提供者選擇 (選用: ollama 或 openai)
AI_PROVIDER=ollama

# ── Ollama 雲端 API 模式設定 ──
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=deepseek-v4-pro:cloud
OLLAMA_API_KEY=72407010c7d6445ca1ba32b4abec7927.yYoXywezx-hZ7Masa1urUyo3

# ── Hugging Face Embedding 模型 ──
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── OpenAI 備用設定 ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_MB=30

# ── FastAPI Auth Core 安全與認證配置 ──
JWT_SECRET_KEY=lessonflow-super-secret-jwt-key-2026
AUTH_DB_PATH=./data/users.db
ADMIN_USERS=admin:admin123
DEFAULT_ADMIN_PASSWORD=admin123
