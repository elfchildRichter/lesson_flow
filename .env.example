# ── GitHub Personal Access Token (用於 Docker 建置時下載私有庫 fastapi-auth-core) ──
GITHUB_TOKEN=

# ── AI 提供者選擇 (選用: gemini, openai, ollama_cloud, ollama_local) ──
AI_PROVIDER=gemini

# ── Google Gemini 雲端模式 (預設首選) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ── Ollama 雲端 API 模式設定 ──
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=deepseek-v4-flash:0731
OLLAMA_CLOUD_VISION_MODEL=qwen2-vl:7b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_API_KEY=

# ── Ollama 本機服務模式 ──
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=qwen3:4b
OLLAMA_LOCAL_VISION_MODEL=qwen2-vl

# ── Hugging Face Embedding 模型 (僅於 Ollama 本地模式啟用，延遲載入) ──
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── OpenAI 設定 ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── 多模態檔案解析控制 ──
ENABLE_MULTIMODAL_PARSING=false
ENABLE_SMART_ROUTING=true
MULTIMODAL_DPI=200
MULTIMODAL_MAX_WORKERS=10
MAX_UPLOAD_MB=30

# ── FastAPI Auth Core 安全與認證配置 ──
JWT_SECRET_KEY=lessonflow-super-secret-jwt-key-2026
AUTH_DB_PATH=./data/users.db
ADMIN_USERS=admin:admin123
DEFAULT_ADMIN_PASSWORD=admin123
